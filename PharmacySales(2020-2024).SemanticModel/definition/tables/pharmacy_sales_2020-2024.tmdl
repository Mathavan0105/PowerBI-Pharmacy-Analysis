	column 'Age Group' =
			
			SWITCH(
			    TRUE(),
			    'pharmacy_sales_2020-2024'[Customer_Age] < 18, "Under 18",
			    'pharmacy_sales_2020-2024'[Customer_Age] >= 18 && 'pharmacy_sales_2020-2024'[Customer_Age] <= 30, "18-30",
			    'pharmacy_sales_2020-2024'[Customer_Age] > 30 && 'pharmacy_sales_2020-2024'[Customer_Age] <= 45, "31-45",
			    'pharmacy_sales_2020-2024'[Customer_Age] > 45 && 'pharmacy_sales_2020-2024'[Customer_Age] <= 60, "46-60",
			    "60+"
			)
		lineageTag: 1dfec186-0a9c-4c87-838c-6a98d24125ee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Profit Margin' = ('pharmacy_sales_2020-2024'[Price] * 0.3) * 'pharmacy_sales_2020-2024'[Quantity_Sold]
		lineageTag: 4cebe9b3-583c-46cc-8179-d0a16e1f01ef
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Prescription Size' =
			
			SWITCH(
			    TRUE(),
			    'pharmacy_sales_2020-2024'[Quantity_Sold] = 1, "Small",
			    'pharmacy_sales_2020-2024'[Quantity_Sold] = 2 || 'pharmacy_sales_2020-2024'[Quantity_Sold] = 3, "Medium",
			    "Large"
			)
		lineageTag: e29f0d35-b011-4689-80f2-695dd7444070
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

