table pharmacy_sales_2020-2024
	lineageTag: 7380119d-93d5-4531-af12-cad18fd3789d

	measure 'Total Sales' = SUMX('pharmacy_sales_2020-2024', 'pharmacy_sales_2020-2024'[Quantity_Sold] * 'pharmacy_sales_2020-2024'[Price])
		lineageTag: f44db6c7-58ab-423b-b49a-24ee5b2c0759

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Prescriptions' = ```
			DISTINCTCOUNT('pharmacy_sales_2020-2024'[Prescription_ID])
			
			```
		formatString: 0
		lineageTag: ed06fffc-aafa-4a0e-9d7b-183c3f814c61

	measure 'Avg Sale per Prescription' = DIVIDE([Total Sales], [Total Prescriptions], 0)
		lineageTag: 6b3fb2d5-915f-4620-ac2a-86b4c4037acd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Sales Growth' =
			
			VAR CurrentYear = YEAR(MAX('pharmacy_sales_2020-2024'[Date]))
			VAR CurrentSales = CALCULATE([Total Sales], YEAR('pharmacy_sales_2020-2024'[Date]) = CurrentYear)
			VAR PrevSales = CALCULATE([Total Sales], YEAR('pharmacy_sales_2020-2024'[Date]) = CurrentYear - 1)
			RETURN DIVIDE(CurrentSales - PrevSales, PrevSales, 0)
		lineageTag: 7ec75608-1e45-4b35-9363-d46eec5c84a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Sales' =
			
			CALCULATE(
			    [Total Sales],DATESMTD('pharmacy_sales_2020-2024'[Date]))
		lineageTag: a160982c-f095-447f-afc5-4e3c50d0834d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cumulative Sales' =
			
			CALCULATE(
			    [Total Sales],
			    FILTER(
			        ALL('pharmacy_sales_2020-2024'[Date]),
			        'pharmacy_sales_2020-2024'[Date] <= MAX('pharmacy_sales_2020-2024'[Date])
			    )
			)
		lineageTag: 6dbf314d-a676-41b0-b0f1-fe84a6a9793d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Medicine' = ```
			
			VAR TopMed =
			    TOPN (
			        1,
			        SUMMARIZE (
			            'pharmacy_sales_2020-2024',
			            'pharmacy_sales_2020-2024'[Medicine_Name],
			            "TotalSales", [Total Sales]
			        ),
			        [TotalSales], DESC
			    )
			RETURN
			MAXX ( TopMed, 'pharmacy_sales_2020-2024'[Medicine_Name] )
			
			```
		lineageTag: 213d95d4-d71b-4e60-81c8-5e0bc0f9bf9e

	measure 'Sales by Gender' = ```
			
			CALCULATE (
			    [Total Sales],
			    ALLEXCEPT ( 'pharmacy_sales_2020-2024', 'pharmacy_sales_2020-2024'[Customer_Gender] )
			)
			
			```
		lineageTag: 1ee39b82-383c-4bd7-8545-6c0955387479

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Prescriptions per Customer' = ```
			
			DIVIDE(
			    [Total Prescriptions],
			    DISTINCTCOUNT('pharmacy_sales_2020-2024'[Customer_ID]),
			    BLANK()
			)
			
			```
		lineageTag: 7adf6020-1bcf-4cbf-a428-ddab00fb3a21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Doctor' = ```
			
			VAR TopDoctorTable =
			    TOPN(
			        1,
			        SUMMARIZE(
			            'pharmacy_sales_2020-2024',
			            'pharmacy_sales_2020-2024'[Doctor_ID],
			            "TotalPrescriptions", [Total Prescriptions]
			        ),
			        [TotalPrescriptions],
			        DESC
			    )
			RETURN
			MAXX(TopDoctorTable, 'pharmacy_sales_2020-2024'[Doctor_ID])
			
			
			```
		formatString: 0
		lineageTag: 079e36e4-8d3b-45f1-97e4-42c7068e9f6d

	measure 'Total Customers' = ```
			
			DISTINCTCOUNT('pharmacy_sales_2020-2024'[Customer_ID])
			
			```
		formatString: 0
		lineageTag: 6bab18cc-68f0-4154-84f8-ca43b78aba6e

	measure 'Total Doctors' =
			
			DISTINCTCOUNT('pharmacy_sales_2020-2024'[Doctor_ID])
		formatString: 0
		lineageTag: b0317a87-b67d-4edd-854b-8689f184bb96

	measure 'Total Profit' = SUM('pharmacy_sales_2020-2024'[Profit Margin])
		lineageTag: 8124dd29-0672-4b38-9631-2a7cf66fb6d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Projected Sales' = ```
			
			VAR GrowthRate = 0.05  // average monthly growth
			RETURN [Total Sales] * (1 + GrowthRate)
			
			```
		lineageTag: 7e976f45-d000-4f07-a817-345e188930ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 5 Doctors' =
			
			TOPN(
			    5,
			    SUMMARIZE(
			        'pharmacy_sales_2020-2024',
			        'pharmacy_sales_2020-2024'[Doctor_ID],
			        "DoctorSales", [Total Sales]
			    ),
			    [DoctorSales],
			    DESC
			)
			RETURN
			MAXX(TopDoctorTable, 'pharmacy_sales_2020-2024'[Doctor_ID])
		lineageTag: 0ec8b1b1-1929-47d7-b57e-d5761ce72407

	measure 'Profit Margin %' = ```
			
			DIVIDE([Total Profit], [Total Sales], 0)
			
			```
		lineageTag: 51b8ce93-fabb-4ada-bbd3-77d3c5021e3d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

